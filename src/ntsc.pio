; SPDX-License-Identifier: GPL-3.0-or-later
; Copyright (C) 2026 Leonardo Roman da Rosa
;
; ntsc.pio  --  composite NTSC video, 1-bit, ~256x192 active
;
; Implementacao clean-room inspirada no projeto brucland/RP2040/PIO/NTSC_1_bit
; (https://github.com/brucland/RP2040). Credito no README do projeto.
;
; Duas state machines no mesmo PIO:
;   ntsc_sync : produz o pino SYNC do DAC. Le um descritor de linha por scanline
;               via DMA (descriptor.bit0 = vsync, descriptor.bit1 = active).
;               Levanta IRQ 4 no inicio do active region das linhas ativas.
;   ntsc_data : aguarda IRQ 4 e clica 256 bits de pixel data por linha.
;
; Combinacao por DAC resistivo (R_sync = 470 ohm, R_video = 270 ohm, term. 75 ohm):
;   sync=0, data=0  ->  ~0.00 V   (sync tip)
;   sync=1, data=0  ->  ~0.37 V   (preto / blanking)
;   sync=1, data=1  ->  ~1.00 V   (branco)
;
; Sync SM clock: sysclk / 147.118 ~ 849650 Hz (periodo ~1.177 us)
;   linha = 54 ciclos = 63.55 us  (NTSC: 63.555 us)
;   frame = 262 linhas = 16.65 ms (~60 Hz field)
;   H-sync = 4 ciclos = 4.71 us   (padrao NTSC/TVout; antes era 9.4 us)
;   V-sync = 3 linhas com 2 broad pulses serrilhados cada (meia-linha:
;            23 LOW + 4 HIGH), como consoles 240p. TVs LED exigem as
;            serrations para manter o H-lock durante o vsync.
;
; Data SM clock: sysclk / 4 = 31.25 MHz (periodo 32 ns)
;   bit period = 5 ciclos = 160 ns -> pixel rate = 6.25 MHz
;   256 bits = 40.96 us -> cabe folgado no active region

.program ntsc_sync
.side_set 1

; -------------------------------------------------------------------------
; Descritor (32 bits, low bits usados):
;   bit 0:  1 = linha de VSYNC (pulso longo)
;   bit 1:  1 = linha ATIVA (gera IRQ 4 para o data SM)
;
; Cada iteracao = 54 ciclos = 1 scanline (63.55 us).
; H-sync = os 4 ciclos de busca do descritor (sync baixo) = 4.71 us.
; -------------------------------------------------------------------------

top:
    pull block          side 0          ; (1)  LOW  busca descritor (H-sync)
    out x, 1            side 0          ; (2)  LOW  x = vsync flag
    out y, 1            side 0          ; (3)  LOW  y = active flag
    jmp !x normal       side 0          ; (4)  LOW  x=0 -> normal ; x=1 -> vsync (cai)

; ---- VSYNC line: 2 "broad pulses" serrilhados a meia-linha (padrao NTSC) ----
; Cada meia-linha (27 ciclos): 23 LOW (27.07 us) + 4 HIGH (4.71 us de serration).
; 3 linhas destas = 6 broad pulses, como consoles classicos em 240p. O sync
; separator da TV depende dessas serrations para manter o H-lock durante o
; vsync; o formato anterior (linha inteira LOW) e rejeitado por muitas TVs LED.
    nop                 side 0 [15]     ; (5..20)  LOW (16)
    nop                 side 0 [2]      ; (21..23) LOW (3)   -> LOW ciclos 1..23
    nop                 side 1 [3]      ; (24..27) HIGH (4)  serration
    nop                 side 0 [15]     ; (28..43) LOW (16)
    nop                 side 0 [6]      ; (44..50) LOW (7)   -> LOW ciclos 28..50
    nop                 side 1 [2]      ; (51..53) HIGH (3)
    jmp top             side 1          ; (54)     HIGH      serration final

normal:
    jmp !y blank        side 1          ; (5)  HIGH libera sync; y=0 -> blank
    nop                 side 1 [7]      ; (6..13)  HIGH back porch (8)
    irq nowait 4        side 1          ; (14) HIGH aciona data SM (video comeca ~16.5us)
    nop                 side 1 [15]     ; (15..30) HIGH (16)
    nop                 side 1 [15]     ; (31..46) HIGH (16)
    nop                 side 1 [6]      ; (47..53) HIGH (7)
    jmp top             side 1          ; (54) HIGH

blank:
    nop                 side 1 [15]     ; (6..21)  HIGH (16)
    nop                 side 1 [15]     ; (22..37) HIGH (16)
    nop                 side 1 [15]     ; (38..53) HIGH (16)
    jmp top             side 1          ; (54) HIGH


; -------------------------------------------------------------------------
; Data SM: shifteia bits do framebuffer durante o active region.
; -------------------------------------------------------------------------

.program ntsc_data

; OUT base = pino DATA. Sem side-set.
; Auto-pull configurado, threshold 32.
; SM clock = sysclk / 4 = 31.25 MHz.

.wrap_target
    set pins, 0                         ; ponta de pino LOW (preto) enquanto idle
    wait 1 irq 4                        ; aguarda IRQ do sync SM

    set x, 7                            ; 8 palavras de 32 bits = 256 pixels
word_loop:
    set y, 31                           ; 32 bits por palavra
bit_loop:
    out pins, 1 [3]                     ; 5 ciclos/bit (out + 3 delay + jmp)
    jmp y-- bit_loop
    jmp x-- word_loop
.wrap
